# =============================================================
# HARVEST — Tower K Energy & Comfort Pill
# Copy to .env (backend) and frontend/.env.local as needed.
# NEVER commit a real .env. All demo data is synthetic.
# =============================================================

# ---- Backend: database ----
# Local docker-compose db maps host 5433 -> container 5432.
DATABASE_URL=postgresql+asyncpg://harvest:harvest@localhost:5433/harvest
# Fallback if asyncpg has no wheel for your Python: swap the driver only.
# DATABASE_URL=postgresql+psycopg://harvest:harvest@localhost:5433/harvest

# ---- Backend: LLM (stub mode by default) ----
# false => deterministic stub; the hero case runs with NO API key.
LLM_ENABLED=false
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
# The LLM may only ever emit pill IDs and rationale codes — never numbers or guidance.

# ---- Backend: app ----
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# ---- Frontend ----
API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
