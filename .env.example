# =============================================================
# HARVEST — Tower K Energy & Comfort Pill
# Copy to backend/.env and frontend/.env.local as needed.
# NEVER commit a real .env. All demo data is synthetic.
# =============================================================

# ---- Backend ----
# The API runs entirely in memory; there is no DATABASE_URL because nothing reads Postgres yet.
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Deterministic seed for the whole synthetic world. Changing it changes every number on the
# demo, including the hero card. The committed value is the one the PRD quotes.
HARVEST_SEED=20261002

# ---- Backend: LLM (stub mode by default) ----
# false => the pipeline runs with no API key and the model boundary does no I/O.
# The model may only ever return the ID of one retrieved candidate — never numbers or guidance.
LLM_ENABLED=false
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# Fallback identity when a request carries no x-harvest-user / x-harvest-role header.
DEMO_USER_ID=11111111-1111-1111-1111-111111111111

# ---- Frontend ----
VITE_API_BASE_URL=http://localhost:8000

# ---- Optional: durable Postgres + pgvector (not yet wired to the API) ----
# docker compose --profile postgres up -d db
POSTGRES_USER=harvest
POSTGRES_PASSWORD=harvest
POSTGRES_DB=harvest
POSTGRES_PORT=5433
