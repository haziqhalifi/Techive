# HARVEST backend — Express + TypeScript
# Copy to .env. The store is in-memory; all data is synthetic.

PORT=8000
NODE_ENV=development

# Comma-separated allowed origins (the Vite dev server).
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Deterministic seed for the synthetic world. Changing it changes every generated number.
HARVEST_SEED=20261002

# The model's only job is to pick one pill ID. With this false the backend runs with no
# API key at all and falls back to a deterministic choice.
LLM_ENABLED=false
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# Demo identity used when a request sends no X-User-Id header.
DEMO_USER_ID=11111111-1111-1111-1111-111111111111
